import streamlit as st
import os
import json
import time
from groq import Groq
from dotenv import load_dotenv

# Load API key
load_dotenv()
client = Groq(api_key=os.getenv("GROQ_API_KEY"))

# Page setup
st.set_page_config(page_title="Call Auto-Fill Assistant", page_icon="📞", layout="centered")
st.markdown("""
    <style>
    /* Main background color - Azercell Purple */
    [data-testid="stAppViewContainer"] {
        background-color: #8E24AA; 
    }
    /* Make all text white for contrast */
    h1, h2, h3, p, label, .stMarkdown, .stText {
        color: white !important;
    }
    /* Keep input boxes white with dark text so they are readable */
    .stTextInput input, .stTextArea textarea {
        color: #333333 !important;
        background-color: white !important;
    }
    /* Style the info box to stand out */
    .stAlert {
        background-color: rgba(255, 255, 255, 0.9) !important;
    }
    </style>
""", unsafe_allow_html=True)

st.title("📞 Text Auto-Fill Assistant")
st.write("Upload or paste a call transcript. The AI will fill the CRM form.")

# Initialize saved tickets in memory
if "saved_tickets" not in st.session_state:
    st.session_state.saved_tickets = []

st.subheader("1. Input Transcript")

# Load Sample Button
if st.button("✨ Load Sample Dialogue"):
    st.session_state["pasted_text"] = """Operator: Azercell müştəri xidmətləri, salam. Mənim adım Gülnar. Sizə necə kömək edə bilərəm?
Müştəri: Salam, mən Elvin Məmmədovam, "Alfa Tikinti" şirkətindən zəng edirəm. Səhərdən bəri korporativ nömrələrimizdə internet işləmir.
Operator: Başa düşürəm, cənab Məmmədov. Hansı nömrələrdə problem var?
Müştəri: Təxminən 30 nömrə. Hamısı eyni SIM kart paketindədir. İşçilərimiz WhatsApp, e-mail heç nəyə girə bilmir.
Operator: Yəni şirkət daxilində kütləvi problemdir?
Müştəri: Bəli, demək olar ki, hamısı. Bu bizim işimizi tam dayandırıb.
Operator: Anladım. Bunu P1 kimi qeyd edirəm və dərhal şəbəkə komandasına ötürürəm. Əlaqə üçün e-poçt ünvanınızı verə bilərsiniz?
Müştəri: elvin.m@alfatikinti.az
Operator: Təşəkkür edirəm. Bir saat içində sizə məlumat veriləcək.
Müştəri: Zəhmət olmasa tez həll edin."""

uploaded_file = st.file_uploader("Upload a .txt transcript", type=["txt"])
pasted_text = st.text_area("OR paste the transcript here", height=200, key="pasted_text")

transcript = ""
if uploaded_file is not None:
    transcript = uploaded_file.read().decode("utf-8")
    st.success("File uploaded successfully!")
elif pasted_text.strip():
    transcript = pasted_text

if transcript:
    with st.expander("Preview transcript"):
        st.text(transcript)

    if st.button("Extract Fields"):
        with st.spinner("AI is reading the transcript..."):
            start_time = time.time()
            
            system_prompt = """
You are an AI that extracts CRM data from call transcripts in Azerbaijani.
Return ONLY valid JSON. No markdown, no explanations.

Fields and Rules:
- customer_name: string or null. Full name of the caller.
- company: string or null. Company name. IF THE CUSTOMER IS AN INDIVIDUAL (no company mentioned), YOU MUST SET THIS TO "Fərdi". Do NOT leave it null.
- contact_info: string or null. Email or phone mentioned by the CUSTOMER. If the customer does not provide it, leave null. Do NOT use the operator's contact info.
- product_service: string or null. Product or service name. If not explicitly named, YOU MUST INFER IT from context. Examples:
  - Internet problem -> "Mobil İnternet"
  - Roaming problem -> "Roaming Xidməti"
  - Balance/Billing issue -> "Balans Xidməti"
  - Stolen SIM -> "SIM Kart"
  - Asking about tariff -> "Tarif: [Tariff Name]"
  - Phone lines down -> "Korporativ Xətt"
  - Corporate numbers -> "Korporativ Mobil Xidmət"
  If you cannot infer it, leave null.
- problem_details: string or null. Summary of the problem.
- priority: one of P0, P1, P2, P3.
  P0 = system down, security breach, data loss
  P1 = major feature broken, many users affected
  P2 = minor issue, workaround exists
  P3 = question, feature request, low impact
- status: one of New, In Progress, Waiting, Escalated, Resolved.
  New = just reported
  In Progress = being worked on
  Waiting = waiting on customer
  Escalated = transferred to higher tier
  Resolved = solved
- next_action: string or null. What needs to happen next.

EXAMPLE:
Transcript: "Salam, mən Leyla Əhmədova. Tarifimdə aylıq internet limiti nə qədərdir?"
Output:
{
  "customer_name": "Leyla Əhmədova",
  "company": "Fərdi",
  "contact_info": null,
  "product_service": "Tarif Sorğusu",
  "problem_details": "Aylıq internet limitini soruşur",
  "priority": "P3",
  "status": "Resolved",
  "next_action": "Müştəriyə tarif limiti barədə məlumat verildi"
}
"""

            response = client.chat.completions.create(
                model="openai/gpt-oss-20b",
                messages=[
                    {"role": "system", "content": system_prompt},
                    {"role": "user", "content": f"Transcript:\n{transcript}"}
                ],
                response_format={"type": "json_object"},
                temperature=0.1
            )

           
            content = response.choices[0].message.content
            if content is None:
                st.error("AI xəta verdi. Zəhmət olmasa yenidən cəhd edin.")
                st.stop()
            result = json.loads(content)

            end_time = time.time()

        st.success("Extraction complete!")
        st.metric(label="⚡ Processing Time", value=f"{round(end_time - start_time, 2)} seconds")

        st.subheader("2. Auto-Filled Form")
        st.info("💡 Qeyd: 'Contact Info' sahəsi boş qala bilər. Çünki CRM sistemində müştərinin nömrəsi onsuz da Caller ID vasitəsilə görünür.")

        with st.expander("Show raw JSON"):
            st.json(result)

        st.text_input("Customer Name", result.get("customer_name") or "")
        st.text_input("Company", result.get("company") or "")
        st.text_input("Contact Info", result.get("contact_info") or "")
        st.text_input("Product/Service", result.get("product_service") or "")
        st.text_area("Problem Details", result.get("problem_details") or "")

        priority_options = ["P0", "P1", "P2", "P3"]
        current_priority = result.get("priority") or "P2"
        st.selectbox("Priority", priority_options, index=priority_options.index(current_priority) if current_priority in priority_options else 2)

        status_options = ["New", "In Progress", "Waiting", "Escalated", "Resolved"]
        current_status = result.get("status") or "New"
        st.selectbox("Status", status_options, index=status_options.index(current_status) if current_status in status_options else 0)

        st.text_area("Next Action", result.get("next_action") or "")

        st.divider()

        col1, col2 = st.columns(2)
        
        with col1:
            st.download_button(
                label="📥 Download Ticket as JSON",
                data=json.dumps(result, ensure_ascii=False, indent=2),
                file_name="ticket.json",
                mime="application/json",
                use_container_width=True
            )
            
        with col2:
            if st.button("💾 Save to CRM", use_container_width=True):
                result["ticket_id"] = f"AZ-{int(time.time())}"
                result["saved_at"] = time.strftime("%Y-%m-%d %H:%M:%S")
                st.session_state.saved_tickets.append(result)
                st.success(f"✅ Ticket {result['ticket_id']} uğurla CRM sisteminə yadda saxlanıldı!")

# --- SECTION 3: SAVED TICKETS VIEW ---
st.divider()
st.subheader("3. Saved Tickets (Mock CRM)")
st.write("This is a preview of what a real CRM would look like. Tickets you save above will appear here.")

if len(st.session_state.saved_tickets) == 0:
    st.info("No tickets saved yet. Extract fields from a transcript and click 'Save to CRM'.")
else:
    for ticket in reversed(st.session_state.saved_tickets):
        with st.container(border=True):
            col_a, col_b = st.columns([3, 1])
            with col_a:
                st.markdown(f"**{ticket.get('ticket_id')}** - {ticket.get('customer_name')} ({ticket.get('company')})")
                st.caption(f"Problem: {ticket.get('problem_details')}")
            with col_b:
                st.markdown(f"**Priority:** `{ticket.get('priority')}`")
                st.markdown(f"**Status:** `{ticket.get('status')}`")